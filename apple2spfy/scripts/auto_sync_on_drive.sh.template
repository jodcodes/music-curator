#!/bin/bash

# Apple2Spfy Auto-Sync on Drive Connection
#
# This is the SINGLE SOURCE OF TRUTH for the drive-triggered sync wrapper.
# setup_drive_sync.sh generates the deployed auto_sync_on_drive.sh by
# copying this file and substituting the placeholders below via sed —
# it does not keep its own separate copy of this script's body, so the
# template, the generator, and the deployed wrapper can never drift apart.

# Configuration (DRIVE_NAME/FALLBACK_PYTHON replaced by setup_drive_sync.sh;
# SCRIPT_DIR resolves itself so a moved/renamed repo checkout never drifts
# out of sync with what got baked in at setup time)
DRIVE_NAME="YOUR_DRIVE_NAME"
DRIVE_PATH="/Volumes/$DRIVE_NAME"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
FALLBACK_PYTHON="FALLBACK_PYTHON_PLACEHOLDER"
LOG_FILE="/tmp/apple2spfy_drive.log"

# shellcheck source=lib/sync_wrapper_helpers.sh
source "$SCRIPT_DIR/scripts/lib/sync_wrapper_helpers.sh"

# Auto-detect Python path (venv, conda, or system)
detect_python() {
    # Check if we're in a virtual environment
    if [ -n "$VIRTUAL_ENV" ]; then
        echo "$VIRTUAL_ENV/bin/python3"
    # Check if we're in a conda environment
    elif [ -n "$CONDA_PREFIX" ]; then
        echo "$CONDA_PREFIX/bin/python3"
    # Check for venv in script directory
    elif [ -f "$SCRIPT_DIR/.venv/bin/python3" ]; then
        echo "$SCRIPT_DIR/.venv/bin/python3"
    # Fall back to the Python that was active during setup
    else
        echo "$FALLBACK_PYTHON"
    fi
}

PYTHON_CMD=$(detect_python)

# Check if drive is mounted
if [ ! -d "$DRIVE_PATH" ]; then
    exit 0
fi

LAST_RUN_FILE="$HOME/.apple2spfy_last_run"
LAST_FAILURE_FILE="$HOME/.apple2spfy_last_failure"
FAILURE_COOLDOWN_SECONDS=3600
ENV_FILE="$SCRIPT_DIR/.env"

# Read STALE_SYNC_DAYS from .env (default to 7 days if not found/invalid)
RAW_STALE_SYNC_DAYS=""
if [ -f "$ENV_FILE" ]; then
    RAW_STALE_SYNC_DAYS=$(grep '^STALE_SYNC_DAYS=' "$ENV_FILE" | head -1 | cut -d'=' -f2)
fi
STALE_SYNC_DAYS=$(parse_stale_sync_days "$RAW_STALE_SYNC_DAYS" 7)

# Convert days to seconds
COOLDOWN_SECONDS=$((STALE_SYNC_DAYS * 86400))

# Check if last run was less than STALE_SYNC_DAYS ago
if [ -f "$LAST_RUN_FILE" ]; then
    RAW_LAST_RUN=$(cat "$LAST_RUN_FILE" 2>/dev/null)
    LAST_RUN=$(parse_last_run_timestamp "$RAW_LAST_RUN")
    if [ -n "$RAW_LAST_RUN" ] && [ "$LAST_RUN" = "0" ]; then
        echo "$(date): WARN: last-run timestamp file contains invalid data ('$RAW_LAST_RUN'), ignoring cooldown." >> "$LOG_FILE"
    elif [ "$LAST_RUN" -gt 0 ]; then
        CURRENT_TIME=$(date +%s)
        TIME_DIFF=$((CURRENT_TIME - LAST_RUN))
        if [ $TIME_DIFF -lt $COOLDOWN_SECONDS ]; then
            HOURS_LEFT=$(((COOLDOWN_SECONDS - TIME_DIFF) / 3600))
            echo "$(date): Less than ${STALE_SYNC_DAYS} days since last sync (approx ${HOURS_LEFT}h remaining). Skipping." >> "$LOG_FILE"
            exit 0
        fi
    fi
fi

# A mounted volume is modified continuously while Music updates its library.
# Do not retry a failed sync on every resulting WatchPaths event.
if [ -f "$LAST_FAILURE_FILE" ]; then
    LAST_FAILURE=$(parse_last_run_timestamp "$(cat "$LAST_FAILURE_FILE" 2>/dev/null)")
    CURRENT_TIME=$(date +%s)
    if is_within_cooldown "$LAST_FAILURE" "$FAILURE_COOLDOWN_SECONDS" "$CURRENT_TIME"; then
        MINUTES_LEFT=$(((FAILURE_COOLDOWN_SECONDS - (CURRENT_TIME - LAST_FAILURE)) / 60))
        echo "$(date): Previous sync failed; retrying in approximately ${MINUTES_LEFT}m." >> "$LOG_FILE"
        exit 0
    fi
fi

# Validate the interpreter before running anything. Under launchd, PATH is
# minimal — never trust a bare "python3" without checking it first.
if ! validate_python_interpreter "$PYTHON_CMD"; then
    echo "$(date): ❌ [START] no usable python interpreter ($PYTHON_CMD). Checked venv/conda/fallback ($FALLBACK_PYTHON)." >> "$LOG_FILE"
    exit 1
fi

# Run sync
echo "$(date): [START] Drive '$DRIVE_NAME' detected and ${STALE_SYNC_DAYS} day(s) passed, starting playlist sync..." >> "$LOG_FILE"
cd "$SCRIPT_DIR" || exit 1

# Run the sync
$PYTHON_CMD sync_playlists.py --clean-sync >> "$LOG_FILE" 2>&1
SYNC_EXIT_CODE=$?

# Create marker file if successful
if [ $SYNC_EXIT_CODE -eq 0 ]; then
    date +%s > "$LAST_RUN_FILE"
    rm -f "$LAST_FAILURE_FILE"
    echo "$(date): [SUCCESS] Sync completed successfully" >> "$LOG_FILE"
else
    date +%s > "$LAST_FAILURE_FILE"
    echo "$(date): [FAIL] Sync failed with exit code $SYNC_EXIT_CODE" >> "$LOG_FILE"
    exit 1
fi
