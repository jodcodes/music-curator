#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
venv="$repo_root/.venv"

if [[ ! -x "$venv/bin/python" ]]; then
  printf 'Python environment is missing; run .agents/setup.\n' >&2
  exit 1
fi

if [[ ! -x "$repo_root/pitch2play/node_modules/.bin/vitest" \
  || ! -x "$repo_root/pitch2play/node_modules/.bin/eslint" ]]; then
  printf 'Pitch2play dependencies are missing; run .agents/setup.\n' >&2
  exit 1
fi

printf 'Orb workspace is ready.\n'
