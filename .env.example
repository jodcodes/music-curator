# Local example only. Copy to .env and fill values there.

# affective_playlists / 4tempers
OPENAI_API_KEY=
# OpenAI model for mood analysis (default: gpt-4.1-nano — cheapest at $0.10/$0.40 per 1M tokens)
OPENAI_MODEL=

# Optional metadata providers
LASTFM_API_KEY=
DISCOGS_TOKEN=

# apple2spfy / Spotify sync
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback
